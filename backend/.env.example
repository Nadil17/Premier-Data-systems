# Application Settings
APP_NAME=Repair Center Management System
APP_VERSION=1.0.0
DEBUG=True

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# OTP Configuration
OTP_EXPIRY_MINUTES=10
